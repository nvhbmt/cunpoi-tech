---
import { site, content as allContent, homePath, type Lang } from '@/data/profile';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = allContent[lang];

const canonical = new URL(homePath(lang), site.url).href;
const ogImage = new URL('/og.png', site.url).href;

// Trang tiếng Việt cần thêm subset `vietnamese` (đ, ơ, ư và toàn bộ dấu);
// trang tiếng Anh nằm trọn trong `latin` nên nạp trước hai file là thừa.
const preloadFonts = [
    '/fonts/inter-latin.woff2',
    '/fonts/space-grotesk-latin.woff2',
    ...(lang === 'vi'
        ? ['/fonts/inter-vietnamese.woff2', '/fonts/space-grotesk-vietnamese.woff2']
        : []),
];

const person = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.author,
    alternateName: site.authorLatin,
    url: site.url,
    email: `mailto:${site.email}`,
    jobTitle: 'Fullstack Developer',
    description: t.meta.description,
    image: ogImage,
    sameAs: [site.github, site.linkedin, site.live],
    address: {
        '@type': 'PostalAddress',
        addressLocality: 'Ho Chi Minh City',
        addressCountry: 'VN',
    },
    worksFor: { '@type': 'Organization', name: 'HDC Flowtech' },
    alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Industrial University of Ho Chi Minh City',
    },
    knowsAbout: [
        'React', 'TypeScript', 'Go', 'Hono', 'Next.js', 'PostgreSQL',
        'Docker', 'Astro', 'Three.js', 'FastAPI',
    ],
};
---

<!doctype html>
<html lang={t.htmlLang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{t.meta.title}</title>
        <meta name="description" content={t.meta.description} />
        <meta name="keywords" content={t.meta.keywords} />
        <meta name="author" content={site.author} />
        <meta name="theme-color" content={site.themeColor} />
        <meta name="color-scheme" content="dark" />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="vi" href={new URL(homePath('vi'), site.url).href} />
        <link rel="alternate" hreflang="en" href={new URL(homePath('en'), site.url).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(homePath('vi'), site.url).href} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content="profile" />
        <meta property="og:site_name" content={site.domain} />
        <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
        <meta property="og:title" content={t.meta.title} />
        <meta property="og:description" content={t.meta.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={t.meta.title} />
        <meta name="twitter:description" content={t.meta.description} />
        <meta name="twitter:image" content={ogImage} />

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/favicon.svg" />

        {/*
          Font tự chứa trong public/fonts (xem src/styles/fonts.css).
          Nạp trước đúng hai subset mà màn hình đầu tiên chắc chắn dùng tới —
          chữ thân bài và chữ tiêu đề của chính ngôn ngữ đang mở. JetBrains Mono
          chỉ dùng cho nhãn nhỏ nên để nó tải thường, `font-display: swap` lo nốt.
        */}
        {preloadFonts.map((href) => (
            <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
        ))}

        <script type="application/ld+json" set:html={JSON.stringify(person)} />
    </head>

    <body>
        <a class="skip-link" href="#main">{t.skipToContent}</a>
        <Nav lang={lang} />
        <main id="main">
            <slot />
        </main>
        <Footer lang={lang} />

        <script>
            import { initUi } from '@/scripts/ui';
            initUi();
        </script>
    </body>
</html>
