---
import { content as allContent, site, type Lang } from '@/data/profile';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = allContent[lang];
const year = new Date().getFullYear();
---

<footer class="foot">
    <div class="shell foot__inner">
        <p class="foot__left">
            <span class="mono">© {year} {t.footer.rights}</span>
            <span class="foot__sep" aria-hidden="true">·</span>
            <a class="mono foot__domain" href={lang === 'vi' ? '/' : '/en'}>{site.domain}</a>
        </p>
        <p class="foot__right mono">{t.footer.built}</p>
    </div>
</footer>

<style>
    .foot {
        border-top: 1px solid var(--line);
        padding-block: 2.25rem;
        position: relative;
        z-index: 1;
    }

    .foot__inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.6rem 1.5rem;
        font-size: 0.76rem;
        color: var(--text-mut);
    }

    .foot__left {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .foot__domain {
        color: var(--text-dim);
        transition: color 0.3s var(--ease);
    }

    .foot__domain:hover {
        color: var(--accent-soft);
    }

    .foot__sep {
        opacity: 0.5;
    }
</style>
