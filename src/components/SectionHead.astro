---
interface Props {
    /** Số thứ tự 01–05. Mục xen giữa (lời nhận xét) bỏ trống để không phá dãy số. */
    n?: string;
    title: string;
    lead?: string;
}

const { n, title, lead } = Astro.props;
---

<header class="head" data-reveal>
    <p class="head__n eyebrow">
        {n && <span>{n}</span>}
        <span class="head__rule" aria-hidden="true"></span>
    </p>
    <h2 class="head__title">{title}</h2>
    {lead && <p class="lead head__lead">{lead}</p>}
</header>

<style>
    .head {
        margin-bottom: clamp(2.25rem, 4vw, 3.5rem);
    }

    .head__n {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-bottom: 1rem;
        color: var(--accent);
    }

    .head__rule {
        height: 1px;
        flex: 1;
        max-width: 7rem;
        background: linear-gradient(to right, rgba(110, 168, 255, 0.55), transparent);
    }

    .head__title {
        font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.1rem);
        margin-bottom: 0.85rem;
    }

    .head__lead {
        color: var(--text-dim);
    }
</style>
