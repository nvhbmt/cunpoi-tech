---
import { content as allContent, site, type Lang } from '@/data/profile';
import SectionHead from '@/components/SectionHead.astro';
import ProjectCard from '@/components/ProjectCard.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = allContent[lang];
const labels = {
    viewCode: t.projects.viewCode,
    viewLive: t.projects.viewLive,
    privateRepo: t.projects.privateRepo,
    shotSoon: t.projects.shotSoon,
};
---

<section class="section" id="projects">
    <div class="shell">
        <SectionHead n={t.projects.n} title={t.projects.title} lead={t.projects.lead} />

        <div class="grid">
            {
                t.projects.items.map((project, i) => (
                    <ProjectCard project={project} labels={labels} index={i} featured={i === 0} />
                ))
            }
        </div>

        <p class="more" data-reveal>
            <a class="link" href={site.github} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                    <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                </svg>
                {t.projects.moreOnGithub} — @{site.githubHandle}
            </a>
        </p>
    </div>
</section>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 27rem), 1fr));
        gap: var(--gap);
        align-items: stretch;
    }

    /* Thẻ đầu tiên là sản phẩm đang chạy thật — cho nó chiếm trọn hàng đầu. */
    .grid > :global(*:first-child) {
        grid-column: 1 / -1;
    }

    .more {
        margin-top: 2.25rem;
        display: flex;
        justify-content: center;
    }

</style>
