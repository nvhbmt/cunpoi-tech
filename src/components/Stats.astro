---
import { content as allContent, type Lang } from '@/data/profile';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = allContent[lang];
---

<section class="stats" aria-label={t.about.title}>
    <div class="shell stats__grid">
        {
            t.stats.map((stat, i) => (
                <div class="stat" data-reveal style={`--reveal-delay:${i * 90}ms`}>
                    <span class="stat__value">{stat.value}</span>
                    <span class="stat__label">{stat.label}</span>
                </div>
            ))
        }
    </div>
</section>

<style>
    .stats {
        border-block: 1px solid var(--line);
        background:
            linear-gradient(to bottom, rgba(146, 172, 220, 0.035), transparent),
            var(--ink-850);
        position: relative;
        z-index: 1;
    }

    .stats__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .stat {
        padding: clamp(1.5rem, 3vw, 2.4rem) clamp(0.75rem, 2vw, 1.5rem);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        position: relative;
    }

    .stat + .stat::before {
        content: '';
        position: absolute;
        left: 0;
        top: 18%;
        bottom: 18%;
        width: 1px;
        background: var(--line);
    }

    .stat__value {
        font-family: var(--font-display);
        font-size: clamp(1.7rem, 1.1rem + 2vw, 2.7rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1;
        background: linear-gradient(135deg, #fff, var(--accent-soft));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .stat__label {
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--text-mut);
        text-wrap: balance;
    }

    @media (max-width: 860px) {
        .stats__grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stat:nth-child(odd)::before {
            display: none;
        }

        .stat:nth-child(n + 3)::after {
            content: '';
            position: absolute;
            inset-inline: 0;
            top: 0;
            height: 1px;
            background: var(--line);
        }
    }
</style>
