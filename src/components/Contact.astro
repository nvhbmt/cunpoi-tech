---
import { content as allContent, site, type Lang } from '@/data/profile';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = allContent[lang];
const f = t.contact.form;

// Chưa điền hồ sơ thật thì thà không có nút LinkedIn còn hơn có một nút dẫn đi đâu không rõ.
const hasLinkedin = site.linkedin !== 'https://www.linkedin.com/in/';
---

<section class="section contact" id="contact">
    <div class="shell">
        <div class="contact__box" data-reveal>
            <div class="contact__grain" aria-hidden="true"></div>

            <p class="eyebrow contact__n">
                <span>{t.contact.n}</span>
                <span class="contact__rule" aria-hidden="true"></span>
            </p>

            <h2 class="contact__title">{t.contact.title}</h2>
            <p class="contact__lead">{t.contact.lead}</p>
            <p class="contact__body">{t.contact.body}</p>

            <a class="contact__mail" href={`mailto:${site.email}`}>
                <span>{site.email}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M5 12h13m0 0-5-5m5 5-5 5" />
                </svg>
            </a>

            <div class="contact__links">
                <a class="btn btn--ghost" href={`mailto:${site.email}`}>{t.contact.emailLabel}</a>
                <a class="btn btn--ghost" href={site.github} target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                        <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                    </svg>
                    {t.contact.githubLabel}
                </a>
                {
                    hasLinkedin && (
                        <a
                            class="btn btn--ghost"
                            href={site.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`LinkedIn — ${site.author}`}
                        >
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.25h4v11.5H3zM10 9.25h3.83v1.57h.06A4.2 4.2 0 0 1 17.7 9c4.1 0 4.86 2.6 4.86 5.98v5.77h-4v-5.12c0-1.22-.02-2.8-1.75-2.8-1.75 0-2.02 1.33-2.02 2.71v5.21h-4z" />
                            </svg>
                            {t.contact.linkedinLabel}
                        </a>
                    )
                }
                <a class="btn btn--ghost" href={site.live} target="_blank" rel="noopener noreferrer">
                    {t.contact.liveLabel}
                </a>
                <a class="btn btn--ghost" href={site.cv} download>{t.contact.cvLabel}</a>
            </div>

            <!--
              `novalidate`: tự kiểm tra bằng script để câu báo lỗi cũng là tiếng Việt
              và cũng nằm trong khung hình của trang. `required` vẫn giữ cho trình đọc
              màn hình biết ô nào bắt buộc, và để biểu mẫu vẫn dùng được nếu JS hỏng.
            -->
            <form
                class="cform"
                data-contact-form
                novalidate
                data-copy-sending={f.sending}
                data-copy-submit={f.submit}
                data-copy-ok={f.ok}
                data-copy-fail={f.fail}
                data-copy-unconfigured={f.unconfigured}
                data-copy-name-error={f.name.error}
                data-copy-email-error={f.email.error}
                data-copy-email-invalid={f.email.invalid}
                data-copy-message-error={f.message.error}
            >
                <h3 class="cform__title">{f.title}</h3>

                <div class="cform__row">
                    <div class="field">
                        <label for="cf-name">{f.name.label}</label>
                        <input
                            id="cf-name"
                            name="name"
                            type="text"
                            autocomplete="name"
                            required
                            placeholder={f.name.placeholder}
                            aria-describedby="cf-name-error"
                        />
                        <p class="field__error" id="cf-name-error" />
                    </div>

                    <div class="field">
                        <label for="cf-email">{f.email.label}</label>
                        <input
                            id="cf-email"
                            name="email"
                            type="email"
                            autocomplete="email"
                            required
                            placeholder={f.email.placeholder}
                            aria-describedby="cf-email-error"
                        />
                        <p class="field__error" id="cf-email-error" />
                    </div>
                </div>

                <div class="field">
                    <label for="cf-message">{f.message.label}</label>
                    <textarea
                        id="cf-message"
                        name="message"
                        rows="5"
                        required
                        placeholder={f.message.placeholder}
                        aria-describedby="cf-message-error"></textarea>
                    <p class="field__error" id="cf-message-error" />
                </div>

                {/* Bẫy bot — người thật không bao giờ thấy ô này. */}
                <input
                    class="cform__trap"
                    type="text"
                    name="botcheck"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                />

                <div class="cform__foot">
                    <button class="btn btn--primary" type="submit" data-submit>
                        {f.submit}
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                            <path d="M4 12h14m0 0-5-5m5 5-5 5" />
                        </svg>
                    </button>

                    {/* `role="status"` báo cho trình đọc màn hình mà không cướp con trỏ. */}
                    <p class="cform__status" data-status role="status" aria-live="polite" />
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    import { initContactForm } from '@/scripts/contact-form';
    initContactForm();
</script>

<style>
    .contact__box {
        position: relative;
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: clamp(2rem, 5vw, 4rem);
        overflow: hidden;
        background:
            radial-gradient(90% 120% at 12% 0%, rgba(110, 168, 255, 0.14), transparent 62%),
            radial-gradient(70% 90% at 92% 100%, rgba(167, 139, 250, 0.12), transparent 62%),
            var(--ink-850);
    }

    /* Lưới kẻ rất mờ, cùng ngôn ngữ hình với hero. */
    .contact__grain {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(to right, rgba(146, 172, 220, 0.05) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(146, 172, 220, 0.05) 1px, transparent 1px);
        background-size: 46px 46px;
        mask-image: radial-gradient(80% 80% at 50% 50%, #000, transparent 75%);
        -webkit-mask-image: radial-gradient(80% 80% at 50% 50%, #000, transparent 75%);
        pointer-events: none;
    }

    .contact__box > :not(.contact__grain) {
        position: relative;
    }

    .contact__n {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        color: var(--accent);
        margin-bottom: 1rem;
    }

    .contact__rule {
        height: 1px;
        flex: 1;
        max-width: 7rem;
        background: linear-gradient(to right, rgba(110, 168, 255, 0.55), transparent);
    }

    .contact__title {
        font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.1rem);
        margin-bottom: 0.75rem;
    }

    .contact__lead {
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 1rem + 0.6vw, 1.45rem);
        color: var(--accent-soft);
        letter-spacing: -0.02em;
        margin-bottom: 0.65rem;
    }

    .contact__body {
        color: var(--text-dim);
        max-width: 56ch;
        margin-bottom: 2rem;
    }

    /* Địa chỉ email in lớn — thứ duy nhất cần nhớ trên trang này. */
    .contact__mail {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        font-family: var(--font-display);
        font-size: clamp(1.15rem, 0.95rem + 1.5vw, 2.1rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        color: var(--text);
        word-break: break-word;
        padding-bottom: 0.35rem;
        background-image: linear-gradient(to right, var(--accent), var(--violet));
        background-repeat: no-repeat;
        background-size: 0% 2px;
        background-position: 0 100%;
        transition: background-size 0.55s var(--ease), color 0.35s var(--ease);
    }

    .contact__mail:hover {
        background-size: 100% 2px;
        color: #fff;
    }

    .contact__mail svg {
        flex-shrink: 0;
        transition: transform 0.45s var(--ease);
    }

    .contact__mail:hover svg {
        transform: translateX(5px);
    }

    .contact__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: 2.25rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
    }

    /* ---------- biểu mẫu ---------- */

    .cform {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2.25rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
    }

    .cform__title {
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        color: var(--text-dim);
    }

    /* Hai ô ngắn đứng cạnh nhau, ô lời nhắn dài nằm riêng một hàng. */
    .cform__row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: 1rem;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        min-width: 0;
    }

    .field label {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-mut);
    }

    .field input,
    .field textarea {
        width: 100%;
        font: inherit;
        font-size: 0.925rem;
        color: var(--text);
        background: rgba(5, 7, 12, 0.55);
        border: 1px solid var(--line-strong);
        border-radius: 10px;
        padding: 0.7rem 0.85rem;
        transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
    }

    .field textarea {
        resize: vertical;
        min-height: 7.5rem;
        line-height: 1.6;
    }

    .field input::placeholder,
    .field textarea::placeholder {
        color: var(--text-mut);
        opacity: 0.75;
    }

    .field input:hover,
    .field textarea:hover {
        border-color: rgba(110, 168, 255, 0.35);
    }

    .field input:focus,
    .field textarea:focus {
        border-color: var(--accent);
        background: rgba(5, 7, 12, 0.8);
    }

    /*
     * Bấm chuột vào ô thì viền sáng lên là đủ, không cần thêm vòng focus.
     * Nhưng người đi bằng phím Tab thì vòng focus là thứ duy nhất cho họ biết
     * đang đứng ở đâu — `:focus-visible` tách đúng hai trường hợp đó, nên chỉ
     * tắt vòng focus ở nhánh không phải bàn phím.
     */
    .field input:focus:not(:focus-visible),
    .field textarea:focus:not(:focus-visible) {
        outline: none;
    }

    /*
     * Viền đỏ là tín hiệu phụ; câu chữ bên dưới mới là tín hiệu chính, vì
     * người mù màu đỏ–lục không phân biệt được viền này với viền thường.
     */
    .field input[aria-invalid='true'],
    .field textarea[aria-invalid='true'] {
        border-color: #f87171;
    }

    /* Ô lỗi rỗng thì không chiếm chỗ; có chữ mới đẩy bố cục xuống. */
    .field__error:empty {
        display: none;
    }

    .field__error {
        font-size: 0.78rem;
        line-height: 1.4;
        color: #fca5a5;
    }

    .cform__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.8rem 1.2rem;
        margin-top: 0.35rem;
    }

    .cform__status:empty {
        display: none;
    }

    .cform__status {
        font-size: 0.85rem;
        line-height: 1.5;
        border-radius: 10px;
        padding: 0.55rem 0.9rem;
        border: 1px solid var(--line-strong);
        color: var(--text-dim);
    }

    .cform__status[data-state='ok'] {
        color: var(--mint);
        border-color: rgba(94, 234, 212, 0.35);
        background: rgba(94, 234, 212, 0.08);
    }

    .cform__status[data-state='fail'] {
        color: #fca5a5;
        border-color: rgba(248, 113, 113, 0.35);
        background: rgba(248, 113, 113, 0.08);
    }

    .cform__status[data-state='unconfigured'] {
        color: var(--accent-soft);
        border-color: rgba(110, 168, 255, 0.35);
        background: rgba(110, 168, 255, 0.08);
    }

    /*
     * Bẫy bot: phải chiếm chỗ thật trong DOM để script tự điền nhìn thấy, nhưng
     * không được lọt vào mắt người hay vào lượt Tab. `display: none` thì nhiều
     * bot bỏ qua luôn, nên đẩy ra ngoài khung hình thay vì ẩn hẳn.
     */
    .cform__trap {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .cform button[disabled] {
        opacity: 0.6;
        cursor: progress;
        transform: none;
    }
</style>
