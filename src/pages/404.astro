---
import Base from '@/layouts/Base.astro';
---

<Base lang="vi">
    <section class="nf">
        <div class="shell nf__inner">
            <p class="eyebrow">404</p>
            <h1>Không có trang này</h1>
            <p class="lead">
                Đường dẫn này không còn nữa, hoặc gõ nhầm ở đâu đó. Quay về trang chủ nhé.
                <br />
                <span class="mono nf__en">That page does not exist — head back to the homepage.</span>
            </p>
            <div class="nf__cta">
                <a class="btn btn--primary" href="/">Về trang chủ</a>
                <a class="btn btn--ghost" href="/en">English version</a>
            </div>
        </div>
    </section>
</Base>

<style>
    .nf {
        min-height: 78svh;
        display: grid;
        place-items: center;
        padding-block: 8rem 4rem;
    }

    .nf__inner {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .nf h1 {
        font-size: clamp(2rem, 1.4rem + 3vw, 3.6rem);
    }

    .nf__en {
        color: var(--text-mut);
        font-size: 0.85rem;
    }

    .nf__cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-top: 0.75rem;
    }
</style>
